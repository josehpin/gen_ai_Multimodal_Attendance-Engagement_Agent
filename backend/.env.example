# Flask Environment Configuration
PORT=5000
FLASK_ENV=development

# Google Gemini API Key (Optional: leave empty to use built-in Intelligent Heuristic/Rule-Based Engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Computer Vision & Processing Settings
SAMPLE_RATE_SECONDS=1.0
MOVEMENT_THRESHOLD=5.0
ATTENDANCE_PRESENT_RATIO=0.70
ATTENDANCE_LATE_RATIO=0.40

# Security & CORS (comma separated origins, e.g. https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=*
