# ==========================================
# Multimodal Attendance & Engagement Agent
# Environment Variables Configuration
# ==========================================

# Frontend Environment Variables (for Vercel deployment)
# Leave empty for local development (uses Vite dev proxy to localhost:5000)
# Set to your deployed Python backend URL for production Vercel deployment:
VITE_API_URL=http://localhost:5000

# Backend Flask Environment Variables
PORT=5000
FLASK_ENV=development

# Google Gemini API Key (Optional)
# If provided, enables Google Gemini 2.5 Flash pedagogical synthesis.
# If omitted, system seamlessly runs built-in Intelligent Heuristic/Rule-Based Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated, e.g. https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=*

# Vision Analytics Calibration
SAMPLE_RATE_SECONDS=1.0
MOVEMENT_THRESHOLD=5.0
ATTENDANCE_PRESENT_RATIO=0.70
ATTENDANCE_LATE_RATIO=0.40
